{
  "schema_version": 1,
  "id": "rsi-wick-baseline",
  "name": "RSI touch + wick rejection",
  "description": "Historical baseline. No documented edge: the RSI extreme alone is not enough, the rejection candle on the last close is required. Previously verified on ~10 months of M1 on gold and oil with a gross edge below the spread cost.",
  "instrument": { "symbol": "XAUUSD.r", "timeframe": "M1" },

  "indicators": [
    { "id": "rsi", "type": "rsi", "params": { "period": 9, "source": "close" } },
    { "id": "atr", "type": "atr", "params": { "period": 14 } }
  ],

  "entry": {
    "long": {
      "op": "and",
      "operands": [
        { "op": "cross_below", "left": { "ref": "rsi" }, "right": { "const": 25 } },
        { "op": "gte", "left": { "feature": "lower_wick_ratio" }, "right": { "const": 0.60 } },
        { "op": "lte", "left": { "feature": "body_ratio" }, "right": { "const": 0.30 } }
      ]
    },
    "short": {
      "op": "and",
      "operands": [
        { "op": "cross_above", "left": { "ref": "rsi" }, "right": { "const": 75 } },
        { "op": "gte", "left": { "feature": "upper_wick_ratio" }, "right": { "const": 0.60 } },
        { "op": "lte", "left": { "feature": "body_ratio" }, "right": { "const": 0.30 } }
      ]
    }
  },

  "exit": {
    "stop_loss": { "type": "points", "value": 150 },
    "take_profit": { "type": "points", "value": 80 },
    "time_stop": { "bars": 60 },
    "signal_exit": null
  },

  "sizing": {
    "type": "equity_per_step",
    "equity_per_001_lot": 100,
    "min_lot": 0.01,
    "max_lot": 0.05
  },

  "risk": {
    "max_open_positions": 1,
    "cooldown_minutes": 20,
    "max_trades_per_day": 20,
    "max_spread_points": 30,
    "session": null,
    "news_filter": null
  }
}
